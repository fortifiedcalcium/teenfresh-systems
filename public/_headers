# Cloudflare Pages response headers for STATIC files only (scripts, styles, fonts, images).
# Pages the worker renders get their security headers (and the Content-Security-Policy) from server/plugins/security.ts.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
