{
  "name": "event-registration",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 5199",
    "check:contrast": "node scripts/check-contrast.js",
    "build": "node scripts/check-contrast.js && NITRO_PRESET=cloudflare-pages nuxt build",
    "preview": "npx wrangler pages dev dist",
    "lint": "eslint components composables layouts lib middleware pages plugins app.vue nuxt.config.ts",
    "test:e2e": "playwright test",
    "lighthouse": "lhci collect && lhci assert",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist --project-name teenfresh --branch main",
    "postinstall": "nuxt prepare",
    "pretest:e2e": "VITE_SUPABASE_URL=http://localhost:54321 VITE_SUPABASE_ANON_KEY=test-anon-key npm run build:csp",
    "build:csp": "NUXT_BUILD_DIR=.nuxt-csp NUXT_OUTPUT_DIR=dist-csp nuxt build",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "nuxt": "^3.17.0",
    "pinia": "^4.1.0",
    "qrcode-generator": "^1.5.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@nuxt/eslint": "^1.0.0",
    "@nuxtjs/tailwindcss": "^6.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.0.0"
  }
}
