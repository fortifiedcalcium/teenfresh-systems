# Browser (safe to expose: the anon key is protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Edge Function secrets: set with `supabase secrets set ...`, never in the browser ----
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# automatically by Supabase; you do not (and cannot) set them yourself.
#
# MAIL_PROVIDER=resend            # resend (default) | smtp
# RESEND_API_KEY=re_xxx
# MAIL_FROM=tickets@your-verified-domain.com
# MAIL_FROM_NAME=Teenfresh
# MAIL_REPLY_TO=teenfreshph@gmail.com
# PUBLIC_SITE_URL=https://your-app.vercel.app   # makes relative image paths absolute in emails
#
# For MAIL_PROVIDER=smtp (e.g. Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# Optional: where the footer's "Report an accessibility issue" link sends email (falls back to the Teenfresh X page)
# VITE_SUPPORT_EMAIL=accessibility@your-domain.com
